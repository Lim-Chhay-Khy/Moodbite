# Copy this file to ".env" if you need to change these.
# Vite only shows variables starting with VITE_ to the React code, and
# EVERYTHING here ends up in the browser — so never put secrets here.

# Address of the Flask API.
VITE_API_URL=http://localhost:5000/api

# ----- Stage 5: Google map -----
# A BROWSER key with "Maps JavaScript API" enabled. Map keys are always
# visible in the browser, so restrict this key in Google Cloud to
# http://localhost:5173/* (and your real site later). Leave empty = no map.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: your own Map ID from Google Cloud. Empty = Google's DEMO_MAP_ID.
VITE_GOOGLE_MAP_ID=
