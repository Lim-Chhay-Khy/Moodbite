# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore, so your password never goes to GitHub.

# ----- Option A: MongoDB Atlas (cloud) -----
# In Atlas: Database -> Connect -> Drivers -> copy the connection string.
# Replace <username> and <password> with your Atlas database user.
# If the password has special characters (@ : / ? #), change them to
# %40 %3A %2F %3F %23, or pick a password with only letters and numbers.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ----- Option B: MongoDB installed on your own computer -----
# Delete the Atlas line above and use this one instead:
# MONGODB_URI=mongodb://localhost:27017

# The database name inside MongoDB (created automatically by seed.py).
MONGO_DB_NAME=moodbite

# The React app's address (allowed by CORS)
FRONTEND_URL=http://localhost:5173

# Port for the Flask server. If 5000 is already in use, use 5001 here
# AND set VITE_API_URL=http://localhost:5001/api in frontend/.env.
PORT=5000
